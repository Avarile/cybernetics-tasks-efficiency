## 8. Key Patterns

### Observer + Hook pattern (mirrors Plane)
```typescript
// Store hook
export const useStore = () => useContext(StoreContext);

// Component
const TaskListRoot = observer(() => {
  const { task, auth } = useStore();

  useEffect(() => {
    task.fetchTasks({ initiativeId: params.slug });
  }, [params.slug]);

  return <TaskListView groupedIds={task.groupedTaskIds} />;
});
```

### Permission hook
```typescript
// core/hooks/use-permissions.ts
export const usePermissions = () => {
  const { auth } = useStore();
  return {
    can: (action: string, subject: string) =>
      auth.currentUser?.role === 'admin' ||
      checkCASL(auth.currentUser?.role, action, subject),
    isAdmin: auth.currentUser?.role === 'admin',
    isManager: ['admin', 'manager'].includes(auth.currentUser?.role),
  };
};

// Usage in component
const { can } = usePermissions();
{can('create', 'Task') && <TaskForm />}
```

### Form pattern (React Hook Form)
```typescript
const { register, handleSubmit, formState: { errors } } = useForm<CreateTaskDto>();
const onSubmit = handleSubmit(async (data) => {
  await task.createTask(data);
  onClose();
});
```

### SWR for read-heavy data (mirrors Plane)
```typescript
// For data that benefits from automatic revalidation
const { data: labels } = useSWR('/api/v1/labels', labelService.list);
```

### File upload flow
```
1. FileUploadButton → fileService.requestSignature({ filename, mimeType, size })
2. Server returns { token, uploadUrl }
3. Client PUTs file to uploadUrl
4. Client POSTs /files/notify/:token to persist
5. Server returns attachment metadata → append to local state
```

### Naming conventions (identical to Plane)
- Files: `kebab-case.tsx`
- Components: `PascalCase`
- Hooks: `use-kebab-case.ts`
- Stores: `domain.store.ts`
- Services: `domain.service.ts`
- Path aliases: `@/*` → `src/*`

